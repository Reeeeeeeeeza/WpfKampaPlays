<Window x:Class="listviewPrj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:listviewPrj"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox Background="DarkOliveGreen"  Foreground="WhiteSmoke" Grid.Row="0" Grid.Column="0" Margin="10" Height="50" Width="300" Name="textBoxInput"/>
        <Button Name="butts" Content="Add" Background="DarkOliveGreen" Foreground="WhiteSmoke" FontSize="15" Grid.Row="0" Grid.Column="1" Margin="10" Height="50" Width="100" Click="ButtonAddItem_Click" HorizontalAlignment="Left"/>
        <Button Name="butts1" Content="Remove" Background="DarkOliveGreen" Foreground="WhiteSmoke" FontSize="15" Grid.Row="0" Grid.Column="1" Margin="10" Height="50" Width="100" Click="ButtonDeleteItem_Click"/>
        <Button Name="butts2" Content="Clear" Background="DarkOliveGreen" Foreground="WhiteSmoke" FontSize="15" Grid.Row="0" Grid.Column="1" Margin="250,0,0,0" Height="50" Width="100" Click="ButtonClearItem_Click"/>

        <ListView Grid.Row="1" Grid.ColumnSpan="2" Margin="10" Name="lvEntries" SelectionMode="Multiple"/>

    </Grid>
</Window>
