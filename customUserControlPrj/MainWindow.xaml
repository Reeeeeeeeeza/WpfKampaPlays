<Window x:Class="customUserControlPrj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:customUserControlPrj"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <local:UserControl1 x:Name="userControl1" Grid.Row="0" Placeholder="Enter First Name"/>
        <local:UserControl1 x:Name="userControl2" Grid.Row="1" Placeholder="Enter Last Name"/>
        <local:UserControl1 x:Name="userControl3" Grid.Row="2" Placeholder="Enter Age"/>
        <local:UserControl1 x:Name="userControl4" Grid.Row="3" Placeholder="Enter Designation"/>
        <local:UserControl1 x:Name="userControl5" Grid.Row="4" Placeholder="Enter Skills"/>
    </Grid>
</Window>
