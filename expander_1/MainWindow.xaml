<Window x:Class="expander_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:expander_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <Button Name="bt" Width="150" Height="150" Content="details" FontSize="32" Click="detail_event"></Button>
        <StackPanel >
            <Expander>
                <TextBlock Name="name1" Foreground="SlateGray" Text="Name" FontSize="20" FontWeight="Bold" Margin="10"/>
            </Expander>
        </StackPanel>

        <Expander Name="expander_details" Grid.Column="1" ExpandDirection="Left">
            <Rectangle Grid.Column="1" Fill="LightGray"/>

        </Expander>
    </Grid>
</Window>
