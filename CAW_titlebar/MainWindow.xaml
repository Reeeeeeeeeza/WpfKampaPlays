<Window x:Class="CAW_titlebar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CAW_titlebar"
        mc:Ignorable="d" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="Gray" Grid.Row="0" FlowDirection="RightToLeft">
            <Button Name="bt1" Content="X" Width="40" Background="Transparent" Foreground="White" BorderBrush="Transparent"         Height="40" Click="CloseButton_Click"/>
            <Button Name="bt2" Content="🗖" Width="40" Background="Transparent" Foreground="White" BorderBrush="Transparent"         Height="40" Click="MaximizeButton_Click"/>
            <Button Name="bt3" Content="-" Width="40" Background="Transparent" Foreground="White" BorderBrush="Transparent"          Height="40" Click="MinimizeButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
